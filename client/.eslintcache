s":"212","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/index.js",[],["213","214"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/App.js",[],["215","216"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Button/Button.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/store/actions/gamePhase.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/serviceWorker.js",[],["217","218"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Layout.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/store/reducers/gamePhase.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/store/reducers/participantData.js",["219"],"import { STORE_STRUCTURE, STORE_SELECTION } from '../actions/participantData';\n\nconst initialState = [{}, {}, {}, {}];\n\n\nexport default (state = initialState, action) => {\n    switch (action.type) {\n        case STORE_STRUCTURE:\n            const structure = {\n                causalStructure: action.structureData.causalStructure\n            };\n            const oldStateStructure = [...state]; // deep copy of state, failed attempt of deepcopy (shallow copy)\n            oldStateStructure[action.conditionNumber].structure= structure;\n\n\n            return oldStateStructure;\n\n            case STORE_SELECTION:\n                const selection = {\n                    planet: action.selectionData.selectedPlanet,\n                    confidence: action.selectionData.confidence\n                };\n                const oldStateSelection = [...state];\n                oldStateSelection[action.conditionNumber].selection= selection;\n                console.log(action);\n                console.log(state);\n                return oldStateSelection;\n    \n        default:\n            return state;\n    }\n}","/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/End.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/store/actions/timer.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/uoeSignature/uoeSignature.js",[],["220","221"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/TryAgainModal.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/constants/draw-network/network_variables.js",["222"],"export default {\n    nodes: ['node1', 'node2'],\n    lines: ['line1', 'line2'],\n    legs: ['legl1', 'legr1', 'legl2', 'legr2'],\n    arms: ['arml1', 'armr1', 'arml2', 'armr2'],\n    bodies: ['body1', 'body2'],\n    arrows: ['arrow1', 'arrow2'],\n    vs: ['vs']\n};\n",["223","224"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Backdrop/Backdrop.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/store/reducers/timer.js",[],["225","226"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/store/actions/conditionData.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/store/actions/participantData.js",["227"],"export const STORE_STRUCTURE = 'STORE_STRUCTURE' ;\nexport const STORE_SELECTION = 'STORE_SELECTION';\n\nconst w = window;\n\nexport const storeSTRUCTURE = structureData => {\n    const causalStructure = structureData.causalStructure;\n    return { type: STORE_STRUCTURE, structureData: {causalStructure: causalStructure}, conditionNumber: structureData.conditionNumber};\n};\n\nexport const storeSELECTION = selectionData => {\n    const selectedPLanet = selectionData.selectedPlanet;\n    const confidence = selectionData.confidence;\n    console.log(selectionData);\n    return { type: STORE_SELECTION, selectionData: {selectedPlanet: selectedPLanet, confidence: confidence}, conditionNumber: selectionData.conditionNumber};\n};\n","/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/timer/Timer.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/uoeSignature/Signature/Signature.js",[],["228","229"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/uoeSignature/Logo/Logo.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Modal/Modal.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Notes.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Ethics.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Experiment/Scenario.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/utils/generate-token.js",["230"],"export default function(length) {\n    let tokens = '';\n    let chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';\n    for (let i = 0; i < length; i ++) {\n        tokens += chars.charAt(Math.floor(Math.random() * chars.length))\n    }\n    return tokens;\n};","/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/utils/shuffleArray.js",["231"],"export default (array) => {\n    for (var i = array.length - 1; i > 0; i--) {\n        var j = Math.floor(Math.random() * (i + 1));\n        var temp = array[i];\n        array[i] = array[j];\n        array[j] = temp;\n    }\n    return array;\n}","/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/constants/Data/SCENARIOS.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/utils/AlphaBetaToArrayData.js",["232"],"export default (alpha, beta) => {\n\n    const w = window;\n    var mean = w.jStat.beta.mean(alpha, beta);\n    var variance = w.jStat.beta.variance(alpha, beta);\n\n    var con_slid_val = w.inverse_log_slider(variance);\n    var con_slid_pos = w.transform_con_slider_val(con_slid_val);\n\n    var x = w.create_arrays(0.01, .99, 1000, alpha, beta)[0];\n    var y = w.create_arrays(0.01, .99, 1000, alpha, beta)[1];\n    return { mean: mean, var: con_slid_pos, x: x, y: y };\n};",["233","234"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Debrief.js",[],["235","236"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Experiment/Condition.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/GameInterface/GameInterface.js",["237"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Action/Action.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/ScoreFrame/ScoreFrame.js",[],["238","239"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Agent/Agent.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Scores/Scores.js",[],["240","241"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Instruction/InsOverview.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Instruction/InsSummary.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Instruction/InsQuiz.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Instruction/Instructions.js",["242"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Instruction/InsTask.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/GameFrame/GameFrame.js",["243","244"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/store/reducers/conditionData.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/StructureFrame/StructureFrame.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/PlanetFrame/PlanetFrame.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/NextPlanet/NextPlanetFrame.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Fish/FishFrame.js",["245","246"],"import React, { useState } from 'react';\nimport { useDispatch, useSelector } from 'react-redux';\nimport Agent from '../Agent/Agent';\nimport blueFishImage from '../../static/images/blue_fish.png';\nimport redFishImage from '../../static/images/red_fish.png';\nimport Button from '../../components/Button/Button';\nimport Classes from './FishFrame.module.css';\n\n\n\nconst FishFrame = props => {\n   \n    const scenario = useSelector(state => state.conditionData.conditionData[state.conditionData.conditionNumber]);\n    const fish = scenario.targetBelief;\n\n    const displayFish = {'red': ['', 'none'],\n                         'deepskyblue': ['none', '']};\n    \n\n\n    return (\n\n        <div className={Classes.FishFrame}  style={{display: props.display}}>\n             {props.children}\n            <Agent width={'400px'} agent_id=\"Fish\" display={displayFish[fish][0]}>\n            <p>In this village, the fisherman gave you a <b>RED</b> fish!</p>\n            <img position={'absolute'} left={'80%'} top={'50%'} height={'200px'} src={redFishImage} alt=\"fish\"/>\n            </Agent>\n            <Agent width={'400px'} agent_id=\"Fish\" display={displayFish[fish][1]}>\n            <p>In this village, the fisherman gave you a <b>BLUE</b> fish!</p>\n            <img position={'absolute'} left={'80%'} top={'50%'} height={'200px'} src={blueFishImage} alt=\"fish\"/>\n        </Agent>\n        <Button position={'absolute'} left={'40%'} top={'105%'} clicked={props.goToGame}>Next</Button>\n   </div>        \n    );\n};\n\nexport default FishFrame; \n\n\n","/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Instruction/InsTask2.js",["247"],"import React, { useState, useEffect } from 'react';\nimport Button from '../../components/Button/Button';\nimport relationshipImage from '../../static/images/select_relationship.png';\nimport planetImage from '../../static/images/select_planet.png';\nimport fishImage from '../../static/images/fish.png';\nimport observeImage from '../../static/images/observe_beliefs.png';\nimport Classes from '../../SASS/containers/Instruction/InsTask2.module.scss';\nimport ScrollDivision from '../../components/ScrollDivision/ScrollDivision';\n\nconst InsTask= props => {\n    const [btnDisplay, setBtnDisplay] = useState(false)\n\n    const showBtn = (e) => {\n        debugger;\n        console.log(e.target.scrollHeight);\n        console.log(e.target.scrollTop);\n        if (e.target.scrollTop > 1650) {\n            setBtnDisplay(true);\n        }\n    };\n\n    return (\n        <div className={Classes.InsTask}>\n            \n            <div className={Classes.InnerContainer}>\n                <h1>Instructions: Procedure</h1>\n                <hr />           \n                <div className={Classes.InsReminder}>\n                    <p><i>*** Please read carefully. You will complete a comprehension quiz at the end. ***</i></p>\n                   \n                </div> \n                <ScrollDivision scroll={showBtn}>\n                <p>In each village, you first receive a fish from the fisherman (scroll down):</p><br></br>\n                <img src={fishImage} alt=\"planets\"/><br></br><br></br>\n                <p>You then observe the beliefs of villagers by clicking the ``<b>Observe Beliefs</b>'' button:</p><br></br>\n                <img src={observeImage} alt=\"planets\"/><br></br><br></br>\n                <p>After observing the beliefs of villagers, you will provide a <b>guess about their relationship</b>:</p><br></br>\n                <img src={relationshipImage} alt=\"planets\"/><br></br><br></br>\n                <p>Finally, you will be asked to select one of the two planets and rate <b>how confident</b> your are in your decision:</p>\n                <img src={planetImage} alt=\"planets\"/>\n                </ScrollDivision >\n                <hr />\n                {btnDisplay && <Button clicked={props.goToInstruction}>Next</Button>}\n            </div>\n        </div>\n    );\n};\n\nexport default InsTask;","/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/ScrollDivision/ScrollDivision.js",[],{"ruleId":"248","replacedBy":"249"},{"ruleId":"250","replacedBy":"251"},{"ruleId":"248","replacedBy":"252"},{"ruleId":"250","replacedBy":"253"},{"ruleId":"248","replacedBy":"254"},{"ruleId":"250","replacedBy":"255"},{"ruleId":"256","severity":1,"message":"257","line":6,"column":1,"nodeType":"258","endLine":32,"endColumn":2},{"ruleId":"248","replacedBy":"259"},{"ruleId":"250","replacedBy":"260"},{"ruleId":"256","severity":1,"message":"261","line":1,"column":1,"nodeType":"258","endLine":9,"endColumn":3},{"ruleId":"248","replacedBy":"262"},{"ruleId":"250","replacedBy":"263"},{"ruleId":"248","replacedBy":"264"},{"ruleId":"250","replacedBy":"265"},{"ruleId"