ePath":"180","messages":"181","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"182","usedDeprecatedRules":"94"},{"filePath":"183","messages":"184","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"94"},{"filePath":"185","messages":"186","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"120"},{"filePath":"187","messages":"188","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"189","messages":"190","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"100"},{"filePath":"191","messages":"192","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"94"},{"filePath":"193","messages":"194","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"94"},{"filePath":"195","messages":"196","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/index.js",[],["197","198"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/App.js",[],["199","200"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Button/Button.js",[],["201","202"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/store/actions/gamePhase.js",[],["203","204"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/serviceWorker.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Layout.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/store/reducers/gamePhase.js",[],["205","206"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/store/reducers/participantData.js",["207"],"import { STORE_STRUCTURE, STORE_SELECTION } from '../actions/participantData';\n\nconst initialState = [{}, {}, {}];\n\n\nexport default (state = initialState, action) => {\n    switch (action.type) {\n        case STORE_STRUCTURE:\n            const structure = {\n                causalStructure: action.structureData.causalStructure\n            };\n            const oldStateStructure = [...state];\n            oldStateStructure[action.conditionNumber].structure= structure;\n            return oldStateStructure;\n\n            case STORE_SELECTION:\n                const selection = {\n                    planet: action.selectionData.planet,\n                    confidence: action.selectionData.confidence\n                };\n                const oldStateSelection = [...state];\n                oldStateSelection[action.conditionNumber].selection= selection;\n                return oldStateSelection;\n    \n        default:\n            return state;\n    }\n}","/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/End.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/store/actions/timer.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/uoeSignature/uoeSignature.js",[],["208","209"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/TryAgainModal.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/constants/draw-network/network_variables.js",["210"],"export default {\n    nodes: ['node1', 'node2'],\n    lines: ['line1', 'line2'],\n    legs: ['legl1', 'legr1', 'legl2', 'legr2'],\n    arms: ['arml1', 'armr1', 'arml2', 'armr2'],\n    bodies: ['body1', 'body2'],\n    arrows: ['arrow1', 'arrow2'],\n    vs: ['vs']\n};\n",["211","212"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Backdrop/Backdrop.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/store/reducers/timer.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/store/actions/conditionData.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/store/actions/participantData.js",["213"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/timer/Timer.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/uoeSignature/Signature/Signature.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/uoeSignature/Logo/Logo.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Modal/Modal.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Notes.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Ethics.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Experiment/Scenario.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/utils/generate-token.js",["214"],"export default function(length) {\n    let tokens = '';\n    let chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';\n    for (let i = 0; i < length; i ++) {\n        tokens += chars.charAt(Math.floor(Math.random() * chars.length))\n    }\n    return tokens;\n};","/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/utils/shuffleArray.js",["215"],"export default (array) => {\n    for (var i = array.length - 1; i > 0; i--) {\n        var j = Math.floor(Math.random() * (i + 1));\n        var temp = array[i];\n        array[i] = array[j];\n        array[j] = temp;\n    }\n    return array;\n}","/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/constants/Data/SCENARIOS.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/utils/AlphaBetaToArrayData.js",["216"],"export default (alpha, beta) => {\n\n    const w = window;\n    var mean = w.jStat.beta.mean(alpha, beta);\n    var variance = w.jStat.beta.variance(alpha, beta);\n\n    var con_slid_val = w.inverse_log_slider(variance);\n    var con_slid_pos = w.transform_con_slider_val(con_slid_val);\n\n    var x = w.create_arrays(0.01, .99, 1000, alpha, beta)[0];\n    var y = w.create_arrays(0.01, .99, 1000, alpha, beta)[1];\n    return { mean: mean, var: con_slid_pos, x: x, y: y };\n};",["217","218"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Debrief.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Experiment/Condition.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/GameInterface/GameInterface.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Action/Action.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/ScoreFrame/ScoreFrame.js",[],["219","220"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Agent/Agent.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Scores/Scores.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Instruction/InsOverview.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Instruction/InsSummary.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Instruction/InsQuiz.js",["221"],"import React, { useState } from 'react';\n\nimport Button from '../../components/Button/Button';\nimport Classes from '../../SASS/containers/Instruction/InsQuiz.module.scss';\nimport vlImage from '../../static/images/vl.png';\nimport TryAgainModal from '../../components/TryAgainModal';\nimport { useDispatch } from 'react-redux';\nimport { changePhase, PHASES } from '../../store/actions/gamePhase';\n\nconst InsQuiz = props => {\n    const dispatch = useDispatch();\n    const [showErrorModal, setShowErrorModal] = useState(false);\n    const [showCorrectModal, setShowCorrectModal] = useState(false);\n\n    const submitAnswersHandler = () => {\n        const answers = Array.from(document.getElementsByClassName('input'));\n        const isCorrect = [answers[0].checked, answers[2].checked, !answers[4].checked, answers[6].checked, answers[8].checked, !answers[10].checked].every(i => i);\n        if (isCorrect) {\n            setShowCorrectModal(true)\n        } else {\n            setShowErrorModal(true)\n        }\n    };\n\n    const closeErrorModalHandler = () => {\n        props.goToInstruction();\n        setShowErrorModal(false);\n    };\n\n    const closeCorrectModalHandler = () => {\n        setShowCorrectModal(false);\n        dispatch(changePhase(PHASES.experiment));\n    };\n    const tryAgainCorrectModal = (\n        <TryAgainModal onCloseModal={closeCorrectModalHandler}>\n            <h2>That's great, you got everything right! You can now start the game! <span role=\"img\" aria-label=\"emoji\">&#128518;</span></h2>\n        </TryAgainModal>\n    );\n    const tryAgainErrorModal = (\n        <TryAgainModal onCloseModal={closeErrorModalHandler}>\n            <h2>You gave at least one wrong answer, please go back and read the instructions more carefully! <span role=\"img\" aria-label=\"emoji\">&#128517;</span></h2>\n        </TryAgainModal>\n    );\n    return (\n        <div className={Classes.InsQuiz}>\n            {showErrorModal && tryAgainErrorModal}\n            {showCorrectModal && tryAgainCorrectModal}\n            <div className={Classes.InnerContainer}>\n                <h1>Instructions: Comprehension quiz</h1>\n                <hr />\n                <p>Please answer the following questions before starting the task. These are necessary for ensuring that you\n\t\t        read and understood the instructions.</p>\n                <div className={Classes.QuizContainer}>\n                    <p className={Classes.Qs}><b>Questions</b></p>\n                    <p className={Classes.Ts}><b>True</b></p>\n                    <p className={Classes.Fs}><b>False</b></p>\n                    <hr className={Classes.Hr} />\n                    <img className={Classes.Vl} src={vlImage} alt=\"vertical line\" />\n                    <input type=\"radio\" name=\"1\" className={[Classes.T1, 'input'].join(\" \")} />\n                    <input type=\"radio\" name=\"1\" className={[Classes.F1, 'input'].join(\" \")} />\n                    <input type=\"radio\" name=\"2\" className={[Classes.T2, 'input'].join(\" \")} />\n                    <input type=\"radio\" name=\"2\" className={[Classes.F2, 'input'].join(\" \")} />\n                    <input type=\"radio\" name=\"3\" className={[Classes.T3, 'input'].join(\" \")} />\n                    <input type=\"radio\" name=\"3\" className={[Classes.F3, 'input'].join(\" \")} />\n                    <input type=\"radio\" name=\"4\" className={[Classes.T4, 'input'].join(\" \")} />\n                    <input type=\"radio\" name=\"4\" className={[Classes.F4, 'input'].join(\" \")} />\n                    <input type=\"radio\" name=\"5\" className={[Classes.T5, 'input'].join(\" \")} />\n                    <input type=\"radio\" name=\"5\" className={[Classes.F5, 'input'].join(\" \")} />\n                    <input type=\"radio\" name=\"6\" className={[Classes.T6, 'input'].join(\" \")} />\n                    <input type=\"radio\" name=\"6\" className={[Classes.F6, 'input'].join(\" \")} />\n                    <li className={Classes.Q1}>1. True.</li>\n                    <li className={Classes.Q2}>2. True.</li>\n                    <li className={Classes.Q3}>3. False.</li>\n                    <li className={Classes.Q4}>4. True.</li>\n                    <li className={Classes.Q5}>5. True.</li>\n                    <li className={Classes.Q6}>6. False.</li>\n                </div>\n                <hr />\n                <br />\n                {/* <Button clicked={submitAnswersHandler}>Next</Button> */}\n                <Button clicked={dispatch(changePhase(PHASES.experiment))}>Next</Button>\n                \n            </div>\n        </div >\n    );\n};\n\nexport default InsQuiz;","/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Instruction/Instructions.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Instruction/InsTask.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/GameFrame/GameFrame.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/store/reducers/conditionData.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/StructureFrame/StructureFrame.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/PlanetFrame/PlanetFrame.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/NextPlanet/NextPlanetFrame.js",[],{"ruleId":"222","replacedBy":"223"},{"ruleId":"224","replacedBy":"225"},{"ruleId":"222","replacedBy":"226"},{"ruleId":"224","replacedBy":"227"},{"ruleId":"222","replacedBy":"228"},{"ruleId":"224","replacedBy":"229"},{"ruleId":"222","