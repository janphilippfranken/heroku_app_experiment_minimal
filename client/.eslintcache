r/client/src/serviceWorker.js",[],["211","212"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Layout.js",[],["213","214"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/store/reducers/gamePhase.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/store/reducers/participantData.js",["215"],"import { STORE_STRUCTURE, STORE_SELECTION } from '../actions/participantData';\n\nconst initialState = [{}, {}, {}, {}];\n\n\nexport default (state = initialState, action) => {\n    switch (action.type) {\n        case STORE_STRUCTURE:\n            const structure = {\n                causalStructure: action.structureData.causalStructure\n            };\n            const oldStateStructure = [...state]; // deep copy of state, failed attempt of deepcopy (shallow copy)\n            oldStateStructure[action.conditionNumber].structure= structure;\n\n\n            return oldStateStructure;\n\n            case STORE_SELECTION:\n                const selection = {\n                    planet: action.selectionData.selectedPlanet,\n                    confidence: action.selectionData.confidence\n                };\n                const oldStateSelection = [...state];\n                oldStateSelection[action.conditionNumber].selection= selection;\n                console.log(action);\n                console.log(state);\n                return oldStateSelection;\n    \n        default:\n            return state;\n    }\n}","/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/End.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/store/actions/timer.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/uoeSignature/uoeSignature.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/TryAgainModal.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/constants/draw-network/network_variables.js",["216"],"export default {\n    nodes: ['node1', 'node2'],\n    lines: ['line1', 'line2'],\n    legs: ['legl1', 'legr1', 'legl2', 'legr2'],\n    arms: ['arml1', 'armr1', 'arml2', 'armr2'],\n    bodies: ['body1', 'body2'],\n    arrows: ['arrow1', 'arrow2'],\n    vs: ['vs']\n};\n",["217","218"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Backdrop/Backdrop.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/store/reducers/timer.js",[],["219","220"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/store/actions/conditionData.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/store/actions/participantData.js",["221"],"export const STORE_STRUCTURE = 'STORE_STRUCTURE' ;\nexport const STORE_SELECTION = 'STORE_SELECTION';\n\nconst w = window;\n\nexport const storeSTRUCTURE = structureData => {\n    const causalStructure = structureData.causalStructure;\n    return { type: STORE_STRUCTURE, structureData: {causalStructure: causalStructure}, conditionNumber: structureData.conditionNumber};\n};\n\nexport const storeSELECTION = selectionData => {\n    const selectedPLanet = selectionData.selectedPlanet;\n    const confidence = selectionData.confidence;\n    console.log(selectionData);\n    return { type: STORE_SELECTION, selectionData: {selectedPlanet: selectedPLanet, confidence: confidence}, conditionNumber: selectionData.conditionNumber};\n};\n","/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/timer/Timer.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/uoeSignature/Signature/Signature.js",[],["222","223"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/uoeSignature/Logo/Logo.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Modal/Modal.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Notes.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Ethics.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Experiment/Scenario.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/utils/generate-token.js",["224"],"export default function(length) {\n    let tokens = '';\n    let chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';\n    for (let i = 0; i < length; i ++) {\n        tokens += chars.charAt(Math.floor(Math.random() * chars.length))\n    }\n    return tokens;\n};","/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/utils/shuffleArray.js",["225"],"export default (array) => {\n    for (var i = array.length - 1; i > 0; i--) {\n        var j = Math.floor(Math.random() * (i + 1));\n        var temp = array[i];\n        array[i] = array[j];\n        array[j] = temp;\n    }\n    return array;\n}","/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/constants/Data/SCENARIOS.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/utils/AlphaBetaToArrayData.js",["226"],"export default (alpha, beta) => {\n\n    const w = window;\n    var mean = w.jStat.beta.mean(alpha, beta);\n    var variance = w.jStat.beta.variance(alpha, beta);\n\n    var con_slid_val = w.inverse_log_slider(variance);\n    var con_slid_pos = w.transform_con_slider_val(con_slid_val);\n\n    var x = w.create_arrays(0.01, .99, 1000, alpha, beta)[0];\n    var y = w.create_arrays(0.01, .99, 1000, alpha, beta)[1];\n    return { mean: mean, var: con_slid_pos, x: x, y: y };\n};",["227","228"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Debrief.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Experiment/Condition.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/GameInterface/GameInterface.js",["229"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Action/Action.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/ScoreFrame/ScoreFrame.js",[],["230","231"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Agent/Agent.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Scores/Scores.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Instruction/InsOverview.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Instruction/InsSummary.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Instruction/InsQuiz.js",["232"],"import React, { useState } from 'react';\n\nimport Button from '../../components/Button/Button';\nimport Classes from '../../SASS/containers/Instruction/InsQuiz.module.scss';\nimport vlImage from '../../static/images/vl.png';\nimport TryAgainModal from '../../components/TryAgainModal';\nimport { useDispatch } from 'react-redux';\nimport { changePhase, PHASES } from '../../store/actions/gamePhase';\n\nconst InsQuiz = props => {\n    const dispatch = useDispatch();\n    const [showErrorModal, setShowErrorModal] = useState(false);\n    const [showCorrectModal, setShowCorrectModal] = useState(false);\n\n    const submitAnswersHandler = () => {\n        const answers = Array.from(document.getElementsByClassName('input'));\n        const isCorrect = [answers[0].checked, answers[2].checked, !answers[4].checked, answers[6].checked, answers[8].checked, !answers[10].checked].every(i => i);\n        if (isCorrect) {\n            setShowCorrectModal(true)\n        } else {\n            setShowErrorModal(true)\n        }\n    };\n\n    const closeErrorModalHandler = () => {\n        props.goToInstruction();\n        setShowErrorModal(false);\n    };\n\n    const closeCorrectModalHandler = () => {\n        setShowCorrectModal(false);\n        dispatch(changePhase(PHASES.experiment));\n    };\n    const tryAgainCorrectModal = (\n        <TryAgainModal onCloseModal={closeCorrectModalHandler}>\n            <h2>That's great, you got everything right! You can now start the game! <span role=\"img\" aria-label=\"emoji\">&#128518;</span></h2>\n        </TryAgainModal>\n    );\n    const tryAgainErrorModal = (\n        <TryAgainModal onCloseModal={closeErrorModalHandler}>\n            <h2>You gave at least one wrong answer, please go back and read the instructions more carefully! <span role=\"img\" aria-label=\"emoji\">&#128517;</span></h2>\n        </TryAgainModal>\n    );\n    return (\n        <div className={Classes.InsQuiz}>\n            {showErrorModal && tryAgainErrorModal}\n            {showCorrectModal && tryAgainCorrectModal}\n            <div className={Classes.InnerContainer}>\n                <h1>Instructions: Comprehension quiz</h1>\n                <hr />\n                <p>Please answer the following questions before starting the task. These are necessary for ensuring that you\n\t\t        read and understood the instructions.</p>\n                <div className={Classes.QuizContainer}>\n                    <p className={Classes.Qs}><b>Questions</b></p>\n                    <p className={Classes.Ts}><b>True</b></p>\n                    <p className={Classes.Fs}><b>False</b></p>\n                    <hr className={Classes.Hr} />\n                    <img className={Classes.Vl} src={vlImage} alt=\"vertical line\" />\n                    <input type=\"radio\" name=\"1\" className={[Classes.T1, 'input'].join(\" \")} />\n                    <input type=\"radio\" name=\"1\" className={[Classes.F1, 'input'].join(\" \")} />\n                    <input type=\"radio\" name=\"2\" className={[Classes.T2, 'input'].join(\" \")} />\n                    <input type=\"radio\" name=\"2\" className={[Classes.F2, 'input'].join(\" \")} />\n                    <input type=\"radio\" name=\"3\" className={[Classes.T3, 'input'].join(\" \")} />\n                    <input type=\"radio\" name=\"3\" className={[Classes.F3, 'input'].join(\" \")} />\n                    <input type=\"radio\" name=\"4\" className={[Classes.T4, 'input'].join(\" \")} />\n                    <input type=\"radio\" name=\"4\" className={[Classes.F4, 'input'].join(\" \")} />\n                    <input type=\"radio\" name=\"5\" className={[Classes.T5, 'input'].join(\" \")} />\n                    <input type=\"radio\" name=\"5\" className={[Classes.F5, 'input'].join(\" \")} />\n                    <input type=\"radio\" name=\"6\" className={[Classes.T6, 'input'].join(\" \")} />\n                    <input type=\"radio\" name=\"6\" className={[Classes.F6, 'input'].join(\" \")} />\n                    <li className={Classes.Q1}>1. True.</li>\n                    <li className={Classes.Q2}>2. True.</li>\n                    <li className={Classes.Q3}>3. False.</li>\n                    <li className={Classes.Q4}>4. True.</li>\n                    <li className={Classes.Q5}>5. True.</li>\n                    <li className={Classes.Q6}>6. False.</li>\n                </div>\n                <hr />\n                <br />\n                {/* <Button clicked={submitAnswersHandler}>Next</Button> */}\n                <Button clicked={dispatch(changePhase(PHASES.experiment))}>Next</Button>\n                \n            </div>\n        </div >\n    );\n};\n\nexport default InsQuiz;","/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Instruction/Instructions.js",["233"],"import React, { useState } from 'react';\nimport InsOverview from './InsOverview';\nimport InsTask from './InsTask';\nimport InsSummary from './InsSummary';\nimport InsQuiz from './InsQuiz';\n\nimport { useSelector, useDispatch } from 'react-redux';\nimport { useEffect } from 'react';\nimport { setTimer } from '../../store/actions/timer';\n\nconst INS_PHASES = {\n    overview: 'INSTRUCTIONS_OVERVIEW',\n    task: 'INSTRUCTIONS_TASK',\n    summary: 'SUMMARY',\n    comprehensionQuiz: 'QUIZ'\n};\n\nconst Instructions = props => {\n    const dispatch = useDispatch();\n\n    useEffect(() => {\n        dispatch(setTimer(true, 1, 5));\n    }, [dispatch]);\n\n    const [instructionsPhase, setInstructionsPhase] = useState(INS_PHASES.overview);\n\n    const goToInstructionHandler = instructionPage => {\n        setInstructionsPhase(instructionPage);\n    };\n\n    let currentInstruction;\n    if (instructionsPhase === INS_PHASES.overview) {\n        currentInstruction = <InsOverview goToInstruction={goToInstructionHandler.bind(this, INS_PHASES.task)}/>;\n    } else if (instructionsPhase === INS_PHASES.task) {\n        currentInstruction = <InsTask goToInstruction={goToInstructionHandler.bind(this, INS_PHASES.summary)} />;\n    } else if (instructionsPhase === INS_PHASES.summary) {\n        currentInstruction = <InsSummary goToInstruction={goToInstructionHandler.bind(this, INS_PHASES.comprehensionQuiz)} />;\n    } else if (instructionsPhase === INS_PHASES.comprehensionQuiz) {\n        currentInstruction = <InsQuiz goToInstruction={goToInstructionHandler.bind(this, INS_PHASES.overview)} />;\n    }\n\n    return (\n        currentInstruction\n    );\n};\n\nexport default Instructions;","/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Instruction/InsTask.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/GameFrame/GameFrame.js",["234","235"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/store/reducers/conditionData.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/StructureFrame/StructureFrame.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/PlanetFrame/PlanetFrame.js",[],["236","237"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/NextPlanet/NextPlanetFrame.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Fish/FishFrame.js",["238","239"],{"ruleId":"240","replacedBy":"241"},{"ruleId":"242","replacedBy":"243"},{"ruleId":"240","replacedBy":"244"},{"ruleId":"242","replacedBy":"245"},{"ruleId":"240","replacedBy":"246"},{"ruleId":"242","replacedBy":"247"},{"ruleId":"240","replacedBy":"248"},{"ruleId":"242","replacedBy":"249"},{"ruleId":"240","replacedBy":"250"},{"ruleId":"242","replacedBy":"251"},{"ruleId":"252","severity":1,"message":"253","line":6,"column":1,"nodeType":"254","endLine":32,"endColumn":2},{"ruleId":"252","severity":1,"message":"255","line":1,"column":1,"nodeType":"254","endLine":9,"endColumn":3},{"ruleId":"240","replacedBy":"256"},{"ruleId":"242","replacedBy":"257"},{"ruleId":"240","replacedBy":"258"},{"ruleId":"242","replacedBy":"259"},{"ruleId":"260","severity":1,"message":"261","line":4,"column":7,"nodeType":"262","messageId":"263","endLine":4,"endColumn":8},{"ruleId":"240","replacedBy":"264"},{"ruleId":"242","replacedBy":"265"},{"ruleId":"252","severity":1,"message":"266","line":1,"column":1,"nodeType":"254","endLine":8,"endColumn":2},{"ruleId":"252","severity":1,"message":"253","line":1,"column":1,"nodeType":"