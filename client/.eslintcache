sers/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/store/reducers/gamePhase.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/store/reducers/participantData.js",["184"],"import { STORE_PRIOR, STORE_POSTERIOR } from '../actions/participantData';\n\nconst initialState = [{}, {}, {}];\n\n\nexport default (state = initialState, action) => {\n    switch (action.type) {\n        case STORE_PRIOR:\n            const prior = {\n                meanRaw: action.priorData.meanRaw,\n                mean: action.priorData.mean,\n                varRaw: action.priorData.varRaw,\n                var: action.priorData.var,\n                a: action.priorData.a,\n                b: action.priorData.b\n            };\n            const oldStatePrior = [...state];\n            oldStatePrior[action.conditionNumber].prior = prior;\n            return oldStatePrior;\n\n            case STORE_POSTERIOR:\n                const posterior = {\n                    meanRaw: action.posteriorData.meanRaw,\n                    mean: action.posteriorData.mean,\n                    varRaw: action.posteriorData.varRaw,\n                    var: action.posteriorData.var,\n                    a: action.posteriorData.a,\n                    b: action.posteriorData.b\n                };\n                const oldStatePosterior = [...state];\n                oldStatePosterior[action.conditionNumber].posterior = posterior;\n                return oldStatePosterior;\n\n        default:\n            return state;\n    }\n}","/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/End.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/store/actions/timer.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/uoeSignature/uoeSignature.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/TryAgainModal.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/constants/draw-network/network_variables.js",["185"],"export default {\n    nodes: ['node1', 'node2'],\n    lines: ['line1', 'line2'],\n    legs: ['legl1', 'legr1', 'legl2', 'legr2'],\n    arms: ['arml1', 'armr1', 'arml2', 'armr2'],\n    bodies: ['body1', 'body2'],\n    arrows: ['arrow1', 'arrow2'],\n    vs: ['vs']\n};\n",["186","187"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Backdrop/Backdrop.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/store/reducers/timer.js",[],["188","189"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/store/actions/conditionData.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/store/actions/participantData.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/timer/Timer.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/uoeSignature/Signature/Signature.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/uoeSignature/Logo/Logo.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Modal/Modal.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Notes.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Ethics.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Experiment/Scenario.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/utils/generate-token.js",["190"],"export default function(length) {\n    let tokens = '';\n    let chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';\n    for (let i = 0; i < length; i ++) {\n        tokens += chars.charAt(Math.floor(Math.random() * chars.length))\n    }\n    return tokens;\n};","/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/utils/shuffleArray.js",["191"],"export default (array) => {\n    for (var i = array.length - 1; i > 0; i--) {\n        var j = Math.floor(Math.random() * (i + 1));\n        var temp = array[i];\n        array[i] = array[j];\n        array[j] = temp;\n    }\n    return array;\n}",["192","193"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/constants/Data/SCENARIOS.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/utils/AlphaBetaToArrayData.js",["194"],"export default (alpha, beta) => {\n\n    const w = window;\n    var mean = w.jStat.beta.mean(alpha, beta);\n    var variance = w.jStat.beta.variance(alpha, beta);\n\n    var con_slid_val = w.inverse_log_slider(variance);\n    var con_slid_pos = w.transform_con_slider_val(con_slid_val);\n\n    var x = w.create_arrays(0.01, .99, 1000, alpha, beta)[0];\n    var y = w.create_arrays(0.01, .99, 1000, alpha, beta)[1];\n    return { mean: mean, var: con_slid_pos, x: x, y: y };\n};",["195","196"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Debrief.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Experiment/Condition.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/GameInterface/GameInterface.js",["197"],"import React from 'react';\nimport Button from '../../components/Button/Button';\nimport GameFrame from '../../components/GameFrame/GameFrame';\nimport ScoreFrame from '../../components/ScoreFrame/ScoreFrame';\n\nimport { useDispatch } from 'react-redux';\nimport { useEffect } from 'react';\n\nimport classes from '../../SASS/containers/GameInterface.module.scss';\nimport { setTimer } from '../../store/actions/timer';\nimport { changePhase, PHASES } from '../../store/actions/gamePhase';\n\n// Game Interface contains the interactive interface during which \n// participants can observe states of others or tell them something\nconst GameInterface = props => {\n    const dispatch = useDispatch();\n\n    useEffect(() => {\n        dispatch(setTimer(true, 1, 5));\n    }, [dispatch]);\n\n    const goToDebriefHandler = () => {\n        dispatch(changePhase(PHASES.ethics));\n    };\n    return (\n        <div className={classes.GameInterface}>\n        <div className={classes.GameForm}>\n            <h2>Game</h2>\n            <hr />\n            {/* <div className={classes.ParagraphContainer}> */}\n                <GameFrame/>\n            \n               \n            {/* </div> */}\n            <Button clicked={goToDebriefHandler}>Continue</Button>\n            \n        </div>\n    </div>\n    );\n};\nexport default GameInterface; ","/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Action/Action.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/ScoreFrame/ScoreFrame.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Agent/Agent.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Scores/Scores.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Instruction/InsOverview.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Instruction/InsSummary.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Instructi