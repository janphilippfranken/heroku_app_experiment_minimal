ent_node_js_simon_jp/server/client/src/store/reducers/gamePhase.js",[],["232","233"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/store/reducers/participantData.js",["234"],"import { STORE_PRIOR, STORE_POSTERIOR } from '../actions/participantData';\n\nconst initialState = [{}, {}, {}];\n\n\nexport default (state = initialState, action) => {\n    switch (action.type) {\n        case STORE_PRIOR:\n            const prior = {\n                meanRaw: action.priorData.meanRaw,\n                mean: action.priorData.mean,\n                varRaw: action.priorData.varRaw,\n                var: action.priorData.var,\n                a: action.priorData.a,\n                b: action.priorData.b\n            };\n            const oldStatePrior = [...state];\n            oldStatePrior[action.conditionNumber].prior = prior;\n            return oldStatePrior;\n\n            case STORE_POSTERIOR:\n                const posterior = {\n                    meanRaw: action.posteriorData.meanRaw,\n                    mean: action.posteriorData.mean,\n                    varRaw: action.posteriorData.varRaw,\n                    var: action.posteriorData.var,\n                    a: action.posteriorData.a,\n                    b: action.posteriorData.b\n                };\n                const oldStatePosterior = [...state];\n                oldStatePosterior[action.conditionNumber].posterior = posterior;\n                return oldStatePosterior;\n\n        default:\n            return state;\n    }\n}","/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/End.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Instructions/Instructions.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Experiment/Experiment.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/store/actions/timer.js",[],["235","236"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/uoeSignature/uoeSignature.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/TryAgainModal.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Instructions/InsOverview.js",[],["237","238"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Instructions/InsPossibleScenario.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Instructions/InsVarSlider.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Instructions/InsSummary.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Experiment/ExpOverview.js",[],["239","240"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Experiment/ExpNeighbourBeliefs.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Experiment/ExpPosterior.js",["241"],"import React, { useState, useEffect } from 'react';\n\nimport { storePosterior } from '../../store/actions/participantData';\n\nimport Classes from '../../SASS/containers/Experiment/ExpPosterior.module.scss';\nimport Button from '../../components/Button/Button';\nimport { useSelector, useDispatch } from 'react-redux';\nimport makeData from '../../utils/AlphaBetaToArrayData';\nimport sepImg from '../../static/images/seperation.png';\nimport Condition from '../../components/Experiment/Condition';\n\nconst w = window;\n\nconst ExpPosterior = props => {\n    const dispatch = useDispatch();\n    const conditionNum = useSelector(state => state.conditionData.conditionNumber);\n    const condition = useSelector(state => state.conditionData.conditions[conditionNum]);\n    const neighbour1Beliefs = useSelector(state => state.conditionData.neighbourBeliefsOrder[conditionNum][0]);\n    const neighbour2Beliefs = useSelector(state => state.conditionData.neighbourBeliefsOrder[conditionNum][1]);\n    const neighbour1Name = useSelector(state => state.conditionData.conditionData[conditionNum].neighbour1Name);\n    const neighbour2Name = useSelector(state => state.conditionData.conditionData[conditionNum].neighbour2Name);\n    const actorName = useSelector(state => state.conditionData.conditionData[conditionNum].name);\n    const actorMotive = useSelector(state => state.conditionData.conditionData[conditionNum].motive);\n    const priorData = useSelector(state => state.participantData[conditionNum].prior);\n\n    useEffect(() => {\n        // NEIGHBOUR 1\n        const neigh1Data = makeData(neighbour1Beliefs.a, neighbour1Beliefs.b);\n        const neigh2Data = makeData(neighbour2Beliefs.a, neighbour2Beliefs.b);\n        const yourData = makeData(priorData.a, priorData.b);\n\n        w.create_plot(neigh1Data.x, neigh1Data.y, neigh1Data.mean.toFixed(2), 'ins_neighbour1_plot', 'Unethical', 'Ethical', 350, neighbour1Name.name, (Math.round(neigh1Data.var)).toString(), '1');\n        w.create_plot(yourData.x, yourData.y, yourData.mean.toFixed(2), 'ins_your_plot', 'Unethical', 'Ethical', 350, \"Your\", (Math.round(yourData.var)).toString(), '1');\n        w.create_plot(neigh2Data.x, neigh2Data.y, neigh2Data.mean.toFixed(2), 'ins_neighbour2_plot', 'Unethical', 'Ethical', 350, neighbour2Name.name, (Math.round(neigh2Data.var)).toString(), '1');\n\n        w.plot_distributions('beliefSlider', 'varSlider', beliefValue, varValue, 'ins_full_plot', 'Unethical', 'Ethical', \"\");\n\n    }, []);\n\n\n    const [beliefValue, setBeliefValue] = useState(priorData.meanRaw);\n    const [varValue, setVarValue] = useState(priorData.varRaw);\n\n    const beliefSliderHandler = e => {\n        setBeliefValue(Math.round(e.target.value));\n    };\n\n    const varSliderHandler = e => {\n        setVarValue(Math.round(e.target.value));\n    };\n\n    const submitDataHandler = () => {\n        dispatch(storePosterior({mean: beliefValue, var: varValue, conditionNumber: conditionNum}));\n        props.goToExperimentPhase();\n    };\n\n    return (\n        <div className={Classes.ExpPosterior}>\n            <div className={Classes.InnerContainer}>\n                <h1>Neighbours' beliefs</h1>\n                <hr />\n                <div className={Classes.NeighboursContainer}>\n\n                    <div className={Classes.Neighbour1ContainerOuter}>\n                        <div className={Classes.Neighbour1Container}>\n                            <div className={Classes.Neighbour1Plot} id=\"ins_neighbour1_plot\" />\n                        </div>\n                    </div>\n                    <img src={sepImg} alt=\"vertical line\" className={Classes.SeperationImage1} />\n                    <div className={Classes.YourContainerOuter}>\n                        <div className={Classes.YourContainer}>\n                            <div className={Classes.YourPlot} id=\"ins_your_plot\" />\n                        </div>\n                    </div>\n                    <img src={sepImg} alt=\"vertical line\" className={Classes.SeperationImage2} />\n                    <div className={Classes.Neighbour2ContainerOuter}>\n                        <div className={Classes.Neighbour2Container}>\n                            <div className={Classes.AlicePlot} id=\"ins_neighbour2_plot\" />\n                        </div>\n\n                    </div>\n                </div>\n                <br />\n                <p className={Classes.SmallDescription}>Now that you have heard from {neighbour1Name.name} and {neighbour2Name.name} --<b>who\n                know that {actorName.name} decided to {actorMotive}</b>-- it is time to revise your\n                initial assessment about {actorName.name}. Use the sliders below to provide your own belief as well as\n                how certain you are about it.</p>\n                <br />\n                <Condition\n                    type={condition}\n                    neighbour1Name={neighbour1Name}\n                    neighbour2Name={neighbour2Name}\n                    actorName={actorName}\n                    isAHint={true}\n                />\n                <hr />\n\n                <div align=\"center\" className={Classes.MainPlot} id=\"ins_full_plot\" >\n                    <p align=\"center\"><b>Belief slider:</b></p>\n                    <input className={Classes.Slider} type=\"range\" min=\"5\" max=\"95\" value={beliefValue} id=\"beliefSlider\" step={0.90909090909} width=\"20%\" onChange={beliefSliderHandler} />\n                    <output className={Classes.Output} id=\"beliefOutput\">{beliefValue}</output>\n\n                    <p align=\"center\"><b>Certainty slider:</b></p>\n                    <input className={Classes.Slider} type=\"range\" min=\"1\" max=\"99\" value={varValue} id=\"varSlider\" step={1} width=\"20%\" onChange={varSliderHandler} />\n                    <output className={Classes.Output} id=\"varOutput\">{varValue}</output>\n                </div>\n                <Button clicked={submitDataHandler}>Next</Button>\n            </div>\n        </div>\n    );\n};\n\nexport default ExpPosterior;",["242","243"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/constants/draw-network/network_variables.js",["244"],"export default {\n    nodes: ['node1', 'node2'],\n    lines: ['line1', 'line2'],\n    legs: ['legl1', 'legr1', 'legl2', 'legr2'],\n    arms: ['arml1', 'armr1', 'arml2', 'armr2'],\n    bodies: ['body1', 'body2'],\n    arrows: ['arrow1', 'arrow2'],\n    vs: ['vs']\n};\n","/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Backdrop/Backdrop.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/store/reducers/timer.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/store/actions/conditionData.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/store/actions/participantData.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/timer/Timer.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Instructions/InsMeanSlider.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/uoeSignature/Signature/Signature.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/uoeSignature/Logo/Logo.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Modal/Modal.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Experiment/ExpPriorBelief.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Notes.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Instructions/InsNeighbourV1.js",[],["245","246"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Experiment/ExpFinishRound.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Ethics.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Instructions/InsQuiz.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Experiment/ExpScenario.js",["247"],"import React, { useState, useEffect } from 'react';\nimport { useDispatch, useSelector } from 'react-redux';\n\nimport Button from '../../components/Button/Button';\nimport Classes from '../../SASS/containers/Experiment/ExpScenario.module.scss';\nimport Scenario from '../../components/Experiment/Scenario';\nimport ExpPriorBelief from '../../containers/Experiment/ExpPriorBelief';\n\n\nconst ExpScenario = props => {\n    const dispatch = useDispatch();\n    const [showPlot, setShowPlot] = useState(false);\n\n    const scenario = useSelector(state => state.conditionData.conditionData[state.conditionData.conditionNumber]);\n\n    const [sec, setSec] = useState(10);\n    useEffect(() => {\n        if (sec === 0) return\n        const countDown = setTimeout(() => {\n            setSec(oldState => oldState - 1);\n        }, 1000)\n        return () => clearTimeout(countDown);\n    }, [sec]);\n\n    const displayPlotHandler = () => {\n        setShowPlot(true);\n    };\n    useEffect(() => {\n        window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });\n    }, [showPlot])\n    let showPlotButton = sec !== 0 ? <Button disabled>Please wait: {sec}</Button> : <Button clicked={displayPlotHandler}>Give answer</Button>;\n    if (showPlot) {\n        showPlotButton = null;\n    };\n    return (\n        <div className={Classes.ExpScenario}>\n            <div className={Classes.InnerContainer}>\n                <Scenario\n                    title={scenario.title}\n                    content={scenario.scenario}\n                    question={scenario.question}\n                    image={scenario.image}\n                    imageAlt={scenario.title}\n                />\n                {showPlotButton}\n                {showPlot && <ExpPriorBelief goToExperimentPhase={props.goToExperimentPhase} />}\n            </div>\n        </div>\n    );\n};\n\nexport default ExpScenario;","/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Experiment/Scenario.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/utils/generate-token.js",["248"],"export default function(length) {\n    let tokens = '';\n    let chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';\n    for (let i = 0; i < length; i ++) {\n        tokens += chars.charAt(Math.floor(Math.random() * chars.length))\n    }\n    return tokens;\n};","/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/utils/shuffleArray.js",["249"],"export default (array) => {\n    for (var i = array.length - 1; i > 0; i--) {\n        var j = Math.floor(Math.random() * (i + 1));\n        var temp = array[i];\n        array[i] = array[j];\n        array[j] = temp;\n    }\n    return array;\n}","/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/constants/Data/SCENARIOS.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/utils/AlphaBetaToArrayData.js",["250"],"export default (alpha, beta) => {\n\n    const w = window;\n    var mean = w.jStat.beta.mean(alpha, beta);\n    var variance = w.jStat.beta.variance(alpha, beta);\n\n    var con_slid_val = w.inverse_log_slider(variance);\n    var con_slid_pos = w.transform_con_slider_val(con_slid_val);\n\n    var x = w.create_arrays(0.01, .99, 1000, alpha, beta)[0];\n    var y = w.create_arrays(0.01, .99, 1000, alpha, beta)[1];\n    return { mean: mean, var: con_slid_pos, x: x, y: y };\n};","/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Debrief.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Instructions/InsPosterior.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Experiment/Condition.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/GameInterface/GameInterface.js",["251"],"import React from 'react';\nimport Button from '../../components/Button/Button';\nimport GameFrame from '../../components/GameFrame/GameFrame';\nimport ScoreFrame from '../../components/ScoreFrame/ScoreFrame';\nimport classes from '../../SASS/containers/GameInterface.module.scss';\n\n// Game Interface contains the interactive interface during which \n// participants can observe states of others or tell them something\nconst GameInterface = props => {\n    return (\n        <div className={classes.GameInterface}>\n        <div className={classes.GameForm}>\n            <h2>Main Game</h2>\n            <hr />\n            {/* <div className={classes.ParagraphContainer}> */}\n                <GameFrame/>\n               \n            {/* </div> */}\n            <Button>Accept Hit</Button>\n            \n        </div>\n    </div>\n    );\n};\nexport default GameInterface; ","/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Action/Action.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/ScoreFrame/ScoreFrame.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Agent/Agent.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Scores/Scores.js",[],{"ruleId":"252","replacedBy":"253"},{"ruleId":"254","replacedBy":"255"},{"ruleId":"252","replacedBy":"256"},{"ruleId":"254","replacedBy":"257"},{"ruleId":"252","replacedBy":"258"},{"ruleId":"254","replacedBy":"259"},{"ruleId":"252","replacedBy":"260"},{"ruleId":"254","replacedBy":"261"},{"ruleId":"252","replacedBy":"262"},{"ruleId":"254","replacedBy":"263"},{"ruleId":"264","severity":1,"message":"265","line":6,"column":1,"nodeType":"266","endLine":37,"endColumn":2},{"ruleId":"252","replacedBy":"267"},{"ruleId":"254","replacedBy":"268"},{"ruleId":"252","replacedBy":"269"},{"ruleId":"254","replacedBy":"270"},{"ruleId":"252","replacedBy":"271"},{"ruleId":"254","replacedBy":"272"},{"ruleId":"273","severity":1,"message":"274","line":38,"column":8,"nodeType":"275","endLine":38,"endColumn":10,"suggestions":"276"},{"ruleId":"252","replacedBy":"277"},{"ruleId":"254","replacedBy":"278"},{"ruleId":"264","severity":1,"message":"279","line":1,"column":1,"nodeType":"266","endLine":9,"endColumn":3},{"ruleId":"252","replacedBy":"280"},{"ruleId":"254","replacedBy":"281"},{"ruleId":"282","severity":1,"message":"283","line":11,"column":11,"nodeType":"284","messageId":"285","endLine":11,"endColumn":19},{"ruleId":"264","severity":1,"message":"286","line":1,"column":1,"nodeType":"266","endLine":8,"endColumn":2},{"ruleId":"264","severity":1,"message":"265","line":1,"column":1,"nodeType":"266","endLine":9,"endColumn":2},{"ruleId":"264","severity":1,"message":"265","line":1,"column":1,"nodeType":"266","endLine":13,"endColumn":3},{"ruleId":"282","severity":1,"message":"287","line":4,"column":8,"nodeType":"284","messageId":"285","endLine":4,"endColumn":18},"no-native-reassign",["288"],"no-negated-in-lhs",["289"],["288"],["289"],["288"],["289"],["288"],["289"],["288"],["289"],"import/no-anonymous-default-export","Assign arrow function to a variable before exporting as module default","ExportDefaultDeclaration",["288"],["289"],["288"],["289"],["288"],["289"],"react-hooks/exhaustive-deps","React Hook useEffect has missing dependencies: 'beliefValue', 'neighbour1Beliefs.a', 'neighbour1Beliefs.b', 'neighbour1Name.name', 'neighbour2Beliefs.a', 'neighbour2Beliefs.b', 'neighbour2Name.name', 'priorData.a', 'priorData.b', and 'varValue'. Either include them or remove the dependency array.","ArrayExpression",["290"],["288"],["289"],"Assign object to a variable before exporting as module default",["288"],["289"],"no-unused-vars","'dispatch' is assigned a value but never used.","Identifier","unusedVar","Unexpected default export of anonymous function","'ScoreFrame' is defined but never used.","no-global-assign","no-unsafe-negation",{"desc":"291","fix":"292"},