on = [...state];\n                oldStateSelection[action.conditionNumber].selection= selection;\n                console.log(action);\n                console.log(state);\n                return oldStateSelection;\n    \n        default:\n            return state;\n    }\n}",["226","227"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/End.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/store/actions/timer.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/uoeSignature/uoeSignature.js",[],["228","229"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/TryAgainModal.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/constants/draw-network/network_variables.js",["230"],"export default {\n    nodes: ['node1', 'node2'],\n    lines: ['line1', 'line2'],\n    legs: ['legl1', 'legr1', 'legl2', 'legr2'],\n    arms: ['arml1', 'armr1', 'arml2', 'armr2'],\n    bodies: ['body1', 'body2'],\n    arrows: ['arrow1', 'arrow2'],\n    vs: ['vs']\n};\n",["231","232"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Backdrop/Backdrop.js",[],["233","234"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/store/reducers/timer.js",[],["235","236"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/store/actions/conditionData.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/store/actions/participantData.js",["237"],"export const STORE_STRUCTURE = 'STORE_STRUCTURE' ;\nexport const STORE_SELECTION = 'STORE_SELECTION';\n\nconst w = window;\n\nexport const storeSTRUCTURE = structureData => {\n    const causalStructure = structureData.causalStructure;\n    return { type: STORE_STRUCTURE, structureData: {causalStructure: causalStructure}, conditionNumber: structureData.conditionNumber};\n};\n\nexport const storeSELECTION = selectionData => {\n    const selectedPLanet = selectionData.selectedPlanet;\n    const confidence = selectionData.confidence;\n    console.log(selectionData);\n    return { type: STORE_SELECTION, selectionData: {selectedPlanet: selectedPLanet, confidence: confidence}, conditionNumber: selectionData.conditionNumber};\n};\n","/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/timer/Timer.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/uoeSignature/Signature/Signature.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/uoeSignature/Logo/Logo.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Modal/Modal.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Notes.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Ethics.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Experiment/Scenario.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/utils/generate-token.js",["238"],"export default function(length) {\n    let tokens = '';\n    let chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';\n    for (let i = 0; i < length; i ++) {\n        tokens += chars.charAt(Math.floor(Math.random() * chars.length))\n    }\n    return tokens;\n};",["239","240"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/utils/shuffleArray.js",["241"],"export default (array) => {\n    for (var i = array.length - 1; i > 0; i--) {\n        var j = Math.floor(Math.random() * (i + 1));\n        var temp = array[i];\n        array[i] = array[j];\n        array[j] = temp;\n    }\n    return array;\n}","/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/constants/Data/SCENARIOS.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/utils/AlphaBetaToArrayData.js",["242"],"export default (alpha, beta) => {\n\n    const w = window;\n    var mean = w.jStat.beta.mean(alpha, beta);\n    var variance = w.jStat.beta.variance(alpha, beta);\n\n    var con_slid_val = w.inverse_log_slider(variance);\n    var con_slid_pos = w.transform_con_slider_val(con_slid_val);\n\n    var x = w.create_arrays(0.01, .99, 1000, alpha, beta)[0];\n    var y = w.create_arrays(0.01, .99, 1000, alpha, beta)[1];\n    return { mean: mean, var: con_slid_pos, x: x, y: y };\n};",["243","244"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Debrief.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Experiment/Condition.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/GameInterface/GameInterface.js",["245"],"import React, { useState } from 'react';\nimport Button from '../../components/Button/Button';\nimport FishFrame from '../../components/Fish/FishFrame';\nimport GameFrame from '../../components/GameFrame/GameFrame';\nimport StructureFrame from '../../components/StructureFrame/StructureFrame';\nimport PlanetFrame from '../../components/PlanetFrame/PlanetFrame';\nimport NextPlanetFrame from '../../components/NextPlanet/NextPlanetFrame';\nimport { incrementCondition } from '../../store/actions/conditionData';\nimport { changePhase, PHASES } from '../../store/actions/gamePhase';\n\nimport { useSelector, useDispatch } from 'react-redux';\nimport { useEffect } from 'react';\n\nimport classes from '../../SASS/containers/GameInterface.module.scss';\nimport { setTimer } from '../../store/actions/timer';\n\n\n// Game Interface contains the interactive interface during which \n// participants can observe states of others or tell them something\nconst GAME_PHASES = {\n    observeFIsh: 'OBSERVE_FISH',\n    observeBeliefs: 'OBSERVE_BELIEFS',\n    selectStructure: 'SELECT_STRUCTURE',\n    selectPlanet: 'SELECT_PLANET',\n    nextPlanet: 'NEXT_PLANET'\n};\n\nconst GameInterface = props => {\n\n    const dispatch = useDispatch();\n    const conditionNumber = useSelector(state => state.conditionData.conditionNumber);\n    const scenario = useSelector(state => state.conditionData.conditionData[state.conditionData.conditionNumber]);\n    \n\n    useEffect(() => {\n        dispatch(setTimer(true, 1, 5));\n    }, [dispatch]);\n\n    const [gamePhase, setGamePhase] = useState(GAME_PHASES.observeFish);\n    const [fishDisplay, setFishDisplay] = useState('');\n    const [beliefDisplay, setBeliefDisplay] = useState('none');\n    const [structureDisplay, setStructureDisplay] = useState('none');\n    const [planetDisplay, setPlanetDisplay] = useState('none');\n    const [nextPlanetDisplay, setNextPlanetDisplay] = useState('none');\n\n\n    const goToGameHandler = gamePhase => {\n        if (gamePhase === GAME_PHASES.observeFish) {\n            setFishDisplay('');\n            setBeliefDisplay('none');\n            setStructureDisplay('none');\n            setNextPlanetDisplay('none');\n            setGamePhase(GAME_PHASES.selectStructure)\n        } else if (gamePhase === GAME_PHASES.observeBeliefs) {\n            setFishDisplay('none');\n            setBeliefDisplay('');\n            setStructureDisplay('none');\n            setNextPlanetDisplay('none');\n            setGamePhase(GAME_PHASES.selectStructure)\n        } else if (gamePhase === GAME_PHASES.selectStructure) {\n            setBeliefDisplay('none');\n            setStructureDisplay('');;\n            setGamePhase(GAME_PHASES.selectPlanet)\n        } else if (gamePhase === GAME_PHASES.selectPlanet) {\n            setBeliefDisplay('none');\n            setStructureDisplay('none');\n            setPlanetDisplay('');\n            setGamePhase(GAME_PHASES.nextPlanet)\n        }\n        else if (gamePhase === GAME_PHASES.nextPlanet) {\n\n            if (conditionNumber === 3) {\n                return dispatch(changePhase(PHASES.debrief));\n            }\n\n            setPlanetDisplay('none');\n            setNextPlanetDisplay('')\n            setGamePhase(GAME_PHASES.observeFish)\n            dispatch(incrementCondition());\n        }\n    };\n\n    \n    return (\n        <div className={classes.GameInterface}>\n        <div className={classes.GameForm}>\n            <h2>{scenario.title}</h2>\n            <hr />\n\n            {/* <div className={classes.ParagraphContainer}> */}\n               \n            <div className={classes.GameContainer}>\n                <FishFrame display={fishDisplay} goToGame={goToGameHandler.bind(this, GAME_PHASES.observeBeliefs)} > </FishFrame>\n                <GameFrame display={beliefDisplay} goToGame={goToGameHandler.bind(this, GAME_PHASES.selectStructure)} ></GameFrame>\n                <StructureFrame display={structureDisplay} goToGame={goToGameHandler.bind(this, GAME_PHASES.selectPlanet)}></StructureFrame>\n                <PlanetFrame display={planetDisplay} goToGame={goToGameHandler.bind(this, GAME_PHASES.nextPlanet)}></PlanetFrame>\n                <NextPlanetFrame display={nextPlanetDisplay} goToGame={goToGameHandler.bind(this, gamePhase)}></NextPlanetFrame>\n            </div>                   \n        </div>\n    </div>\n    );\n};\nexport default GameInterface; ",["246","247"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Action/Action.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/ScoreFrame/ScoreFrame.js",[],["248","249"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Agent/Agent.js",[],["250","251"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Scores/Scores.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Instruction/InsOverview.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Instruction/InsSummary.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Instruction/InsQuiz.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Instruction/Instructions.js",["252"],"import React, { useState } from 'react';\nimport InsOverview from './InsOverview';\nimport InsTask from './InsTask';\nimport InsTask2 from './InsTask2';\nimport InsSummary from './InsSummary';\nimport InsQuiz from './InsQuiz';\n\nimport { useSelector, useDispatch } from 'react-redux';\nimport { useEffect } from 'react';\nimport { setTimer } from '../../store/actions/timer';\n\nconst INS_PHASES = {\n    overview: 'INSTRUCTIONS_OVERVIEW',\n    task: 'INSTRUCTIONS_TASK',\n    task2: 'INSTRUCTIONS_TASK_2',\n    summary: 'SUMMARY',\n    comprehensionQuiz: 'QUIZ'\n};\n\nconst Instructions = props => {\n    const dispatch = useDispatch();\n\n    useEffect(() => {\n        dispatch(setTimer(true, 1, 5));\n    }, [dispatch]);\n\n    const [instructionsPhase, setInstructionsPhase] = useState(INS_PHASES.overview);\n\n    const goToInstructionHandler = instructionPage => {\n        setInstructionsPhase(instructionPage);\n    };\n\n    let currentInstruction;\n    if (instructionsPhase === INS_PHASES.overview) {\n        currentInstruction = <InsOverview goToInstruction={goToInstructionHandler.bind(this, INS_PHASES.task)}/>;\n    } else if (instructionsPhase === INS_PHASES.task) {\n        currentInstruction = <InsTask goToInstruction={goToInstructionHandler.bind(this, INS_PHASES.task2)} />;\n    } else if (instructionsPhase === INS_PHASES.task2) {\n        currentInstruction = <InsTask2 goToInstruction={goToInstructionHandler.bind(this, INS_PHASES.summary)} />;\n    } else if (instructionsPhase === INS_PHASES.summary) {\n        currentInstruction = <InsSummary goToInstruction={goToInstructionHandler.bind(this, INS_PHASES.comprehensionQuiz)} />;\n    } else if (instructionsPhase === INS_PHASES.comprehensionQuiz) {\n        currentInstruction = <InsQuiz goToInstruction={goToInstructionHandler.bind(this, INS_PHASES.overview)} />;\n    }\n\n    return (\n        currentInstruction\n    );\n};\n\nexport default Instructions;","/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Instruction/InsTask.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/GameFrame/GameFrame.js",["253","254","255","256","257"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/store/reducers/conditionData.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/StructureFrame/StructureFrame.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/PlanetFrame/PlanetFrame.js",["258","259","260","261"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/NextPlanet/NextPlanetFrame.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Fish/FishFrame.js",["262","263"],"import React, { useState } from 'react';\nimport { useDispatch, useSelector } from 'react-redux';\nimport Agent from '../Agent/Agent';\nimport blueFishImage from '../../static/images/blue_fish.png';\nimport redFishImage from '../../static/images/red_fish.png';\nimport Button from '../../components/Button/Button';\nimport Classes from './FishFrame.module.css';\n\n\n\nconst FishFrame = props => {\n   \n    const scenario = useSelector(state => state.conditionData.conditionData[state.conditionData.conditionNumber]);\n    const fish = scenario.targetBelief;\n\n    const displayFish = {'red': ['', 'none'],\n                         'deepskyblue': ['none', '']};\n    \n\n\n    return (\n\n        <div className={Classes.FishFrame}  style={{display: props.display}}>\n             {props.children}\n            <Agent width={'400px'} agent_id=\"Fish\" display={displayFish[fish][0]}>\n            <p>In this village, the fisherman gave you a <b>RED</b> fish!</p>\n            <img position={'absolute'} left={'80%'} top={'50%'} height={'200px'} src={redFishImage} alt=\"fish\"/>\n            </Agent>\n            <Agent width={'400px'} agent_id=\"Fish\" display={displayFish[fish][1]}>\n            <p>In this village, the fisherman gave you a <b>BLUE</b> fish!</p>\n            <img position={'absolute'} left={'80%'} top={'50%'} height={'200px'} src={blueFishImage} alt=\"fish\"/>\n        </Agent>\n        <Button position={'absolute'} left={'40%'} top={'105%'} clicked={props.goToGame}>Next</Button>\n   </div>        \n    );\n};\n\nexport default FishFrame; \n\n\n","/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Instruction/InsTask2.js",["264","265"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/ScrollDivision/ScrollDivision.js",[],{"ruleId":"266","replacedBy":"267"},{"ruleId":"268","replacedBy":"269"},{"ruleId":"266","replacedBy":"270"},{"ruleId":"268","replacedBy":"271"},{"ruleId":"266","replacedBy":"272"},{"ruleId":"268","replacedBy":"273"},{"ruleId":"266","replacedBy":"274"},{"ruleId":"268","replacedBy":"275"},{"ruleId":"276","severity":1,"message":"277","line":6,"column":1,"nodeType":"278","endLine":32,"endColumn":2},{"ruleId":"266","replacedBy":"279"},{"ruleId":"268","replacedBy":"280"},{"ruleId":"26