te = [{}, {}, {}, {}];\n\n\nexport default (state = initialState, action) => {\n    switch (action.type) {\n        case STORE_STRUCTURE:\n            const structure = {\n                causalStructure: action.structureData.causalStructure\n            };\n            console.log(state);\n            const oldStateStructure = [...state]; // deep copy of state, failed attempt of deepcopy (shallow copy)\n            oldStateStructure[action.conditionNumber].structure= structure;\n            return oldStateStructure;\n    \n        case STORE_SELECTION:\n            const selection = {\n                planet: action.selectionData.selectedPlanet,\n                confidence: action.selectionData.confidence\n            };\n            const oldStateSelection = [...state];\n            oldStateSelection[action.conditionNumber].selection= selection;\n            console.log(action);\n            console.log(state);\n            return oldStateSelection;\n\n        default:\n            return state;\n    }\n}","/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/End.js",["241"],"import React from 'react';\n\nimport Classes from '../SASS/containers/End.module.scss';\nimport { useSelector } from 'react-redux';\n\nconst End = props => {\n    const participantToken = useSelector(state => state.participantToken);\n\n    return (\n        <div className={Classes.End}>\n            <div className={Classes.InnerContainer}>\n                <h1>You reached the end!!</h1>\n                <hr />\n                <p>Copy this code to be eligible via payment on Prolific: 84C57C3F</p>\n                     {/* {participantToken}</p> */}\n                <hr />\n                <img src='https://www.nownovel.com/include/images/icons/round_mountain.png' alt=\"thank you\" />\n            </div>\n        </div>\n    );\n};\n\nexport default End;","/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/store/actions/timer.js",[],["242","243"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/uoeSignature/uoeSignature.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/TryAgainModal.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/constants/draw-network/network_variables.js",["244"],"export default {\n    nodes: ['node1', 'node2'],\n    lines: ['line1', 'line2'],\n    legs: ['legl1', 'legr1', 'legl2', 'legr2'],\n    arms: ['arml1', 'armr1', 'arml2', 'armr2'],\n    bodies: ['body1', 'body2'],\n    arrows: ['arrow1', 'arrow2'],\n    vs: ['vs']\n};\n",["245","246"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Backdrop/Backdrop.js",[],["247","248"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/store/reducers/timer.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/store/actions/conditionData.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/store/actions/participantData.js",["249"],"export const STORE_STRUCTURE = 'STORE_STRUCTURE' ;\nexport const STORE_SELECTION = 'STORE_SELECTION';\n\n\nconst w = window;\n\nexport const storeSTRUCTURE = structureData => {\n    const causalStructure = structureData.causalStructure;\n    return { type: STORE_STRUCTURE, structureData: {causalStructure: causalStructure}, conditionNumber: structureData.conditionNumber};\n};\n\nexport const storeSELECTION = selectionData => {\n    const selectedPLanet = selectionData.selectedPlanet;\n    const confidence = selectionData.confidence;\n    console.log(selectionData);\n    return { type: STORE_SELECTION, selectionData: {selectedPlanet: selectedPLanet, confidence: confidence}, conditionNumber: selectionData.conditionNumber};\n};\n\n",["250","251"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/timer/Timer.js",[],["252","253"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/uoeSignature/Signature/Signature.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/uoeSignature/Logo/Logo.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Modal/Modal.js",[],["254","255"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Notes.js",[],["256","257"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Ethics.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Experiment/Scenario.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/utils/generate-token.js",["258"],"export default function(length) {\n    let tokens = '';\n    let chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';\n    for (let i = 0; i < length; i ++) {\n        tokens += chars.charAt(Math.floor(Math.random() * chars.length))\n    }\n    return tokens;\n};",["259","260"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/utils/shuffleArray.js",["261"],"export default (array) => {\n    for (var i = array.length - 1; i > 0; i--) {\n        var j = Math.floor(Math.random() * (i + 1));\n        var temp = array[i];\n        array[i] = array[j];\n        array[j] = temp;\n    }\n    return array;\n}","/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/constants/Data/SCENARIOS.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/utils/AlphaBetaToArrayData.js",["262"],"export default (alpha, beta) => {\n\n    const w = window;\n    var mean = w.jStat.beta.mean(alpha, beta);\n    var variance = w.jStat.beta.variance(alpha, beta);\n\n    var con_slid_val = w.inverse_log_slider(variance);\n    var con_slid_pos = w.transform_con_slider_val(con_slid_val);\n\n    var x = w.create_arrays(0.01, .99, 1000, alpha, beta)[0];\n    var y = w.create_arrays(0.01, .99, 1000, alpha, beta)[1];\n    return { mean: mean, var: con_slid_pos, x: x, y: y };\n};",["263","264"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Debrief.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Experiment/Condition.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/GameInterface/GameInterface.js",["265"],"import React, { useState } from 'react';\nimport Button from '../../components/Button/Button';\nimport FishFrame from '../../components/Fish/FishFrame';\nimport GameFrame from '../../components/GameFrame/GameFrame';\nimport StructureFrame from '../../components/StructureFrame/StructureFrame';\nimport PlanetFrame from '../../components/PlanetFrame/PlanetFrame';\nimport NextPlanetFrame from '../../components/NextPlanet/NextPlanetFrame';\nimport { incrementCondition } from '../../store/actions/conditionData';\nimport { changePhase, PHASES } from '../../store/actions/gamePhase';\n\nimport { useSelector, useDispatch } from 'react-redux';\nimport { useEffect } from 'react';\n\nimport classes from '../../SASS/containers/GameInterface.module.scss';\nimport { setTimer } from '../../store/actions/timer';\n\n\n// Game Interface contains the interactive interface during which \n// participants can observe states of others or tell them something\nconst GAME_PHASES = {\n    observeFIsh: 'OBSERVE_FISH',\n    observeBeliefs: 'OBSERVE_BELIEFS',\n    selectStructure: 'SELECT_STRUCTURE',\n    selectPlanet: 'SELECT_PLANET',\n    nextPlanet: 'NEXT_PLANET'\n};\n\nconst GameInterface = props => {\n\n    const dispatch = useDispatch();\n    const conditionNumber = useSelector(state => state.conditionData.conditionNumber);\n    const scenario = useSelector(state => state.conditionData.conditionData[state.conditionData.conditionNumber]);\n    \n\n    useEffect(() => {\n        dispatch(setTimer(true, 1, 5));\n    }, [dispatch]);\n\n    const [gamePhase, setGamePhase] = useState(GAME_PHASES.observeFish);\n    const [fishDisplay, setFishDisplay] = useState('');\n    const [beliefDisplay, setBeliefDisplay] = useState('none');\n    const [structureDisplay, setStructureDisplay] = useState('none');\n    const [planetDisplay, setPlanetDisplay] = useState('none');\n    const [nextPlanetDisplay, setNextPlanetDisplay] = useState('none');\n\n\n    const goToGameHandler = gamePhase => {\n        if (gamePhase === GAME_PHASES.observeFish) {\n            setFishDisplay('');\n            setBeliefDisplay('none');\n            setStructureDisplay('none');\n            setNextPlanetDisplay('none');\n            setGamePhase(GAME_PHASES.selectStructure)\n        } else if (gamePhase === GAME_PHASES.observeBeliefs) {\n            setFishDisplay('none');\n            setBeliefDisplay('');\n            setStructureDisplay('none');\n            setNextPlanetDisplay('none');\n            setGamePhase(GAME_PHASES.selectStructure)\n        } else if (gamePhase === GAME_PHASES.selectStructure) {\n            setBeliefDisplay('none');\n            setStructureDisplay('');;\n            setGamePhase(GAME_PHASES.selectPlanet)\n        } else if (gamePhase === GAME_PHASES.selectPlanet) {\n            setBeliefDisplay('none');\n            setStructureDisplay('none');\n            setPlanetDisplay('');\n            setGamePhase(GAME_PHASES.nextPlanet)\n        }\n        else if (gamePhase === GAME_PHASES.nextPlanet) {\n\n            if (conditionNumber === 3) {\n                return dispatch(changePhase(PHASES.debrief));\n            }\n\n            setPlanetDisplay('none');\n            setNextPlanetDisplay('')\n            setGamePhase(GAME_PHASES.observeFish)\n            dispatch(incrementCondition());\n        }\n    };\n\n    \n    return (\n        <div className={classes.GameInterface}>\n        <div className={classes.GameForm}>\n            <h2>{scenario.title}</h2>\n            <hr />\n\n            {/* <div className={classes.ParagraphContainer}> */}\n               \n            <div className={classes.GameContainer}>\n                <FishFrame display={fishDisplay} goToGame={goToGameHandler.bind(this, GAME_PHASES.observeBeliefs)} > </FishFrame>\n                <GameFrame display={beliefDisplay} goToGame={goToGameHandler.bind(this, GAME_PHASES.selectStructure)} ></GameFrame>\n                <StructureFrame display={structureDisplay} goToGame={goToGameHandler.bind(this, GAME_PHASES.selectPlanet)}></StructureFrame>\n                <PlanetFrame display={planetDisplay} goToGame={goToGameHandler.bind(this, GAME_PHASES.nextPlanet)}></PlanetFrame>\n                <NextPlanetFrame display={nextPlanetDisplay} goToGame={goToGameHandler.bind(this, gamePhase)}></NextPlanetFrame>\n            </div>                   \n        </div>\n    </div>\n    );\n};\nexport default GameInterface; ","/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Action/Action.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/ScoreFrame/ScoreFrame.js",[],["266","267"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Agent/Agent.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Scores/Scores.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Instruction/InsOverview.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Instruction/InsSummary.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Instruction/InsQuiz.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Instruction/Instructions.js",["268"],"import React, { useState } from 'react';\nimport InsOverview from './InsOverview';\nimport InsTask from './InsTask';\nimport InsTask2 from './InsTask2';\nimport InsSummary from './InsSummary';\nimport InsQuiz from './InsQuiz';\n\nimport { useSelector, useDispatch } from 'react-redux';\nimport { useEffect } from 'react';\nimport { setTimer } from '../../store/actions/timer';\n\nconst INS_PHASES = {\n    overview: 'INSTRUCTIONS_OVERVIEW',\n    task: 'INSTRUCTIONS_TASK',\n    task2: 'INSTRUCTIONS_TASK_2',\n    summary: 'SUMMARY',\n    comprehensionQuiz: 'QUIZ'\n};\n\nconst Instructions = props => {\n    const dispatch = useDispatch();\n\n    useEffect(() => {\n        dispatch(setTimer(true, 1, 5));\n    }, [dispatch]);\n\n    const [instructionsPhase, setInstructionsPhase] = useState(INS_PHASES.overview);\n\n    const goToInstructionHandler = instructionPage => {\n        setInstructionsPhase(instructionPage);\n    };\n\n    let currentInstruction;\n    if (instructionsPhase === INS_PHASES.overview) {\n        currentInstruction = <InsOverview goToInstruction={goToInstructionHandler.bind(this, INS_PHASES.task)}/>;\n    } else if (instructionsPhase === INS_PHASES.task) {\n        currentInstruction = <InsTask goToInstruction={goToInstructionHandler.bind(this, INS_PHASES.task2)} />;\n    } else if (instructionsPhase === INS_PHASES.task2) {\n        currentInstruction = <InsTask2 goToInstruction={goToInstructionHandler.bind(this, INS_PHASES.summary)} />;\n    } else if (instructionsPhase === INS_PHASES.summary) {\n        currentInstruction = <InsSummary goToInstruction={goToInstructionHandler.bind(this, INS_PHASES.comprehensionQuiz)} />;\n    } else if (instructionsPhase === INS_PHASES.comprehensionQuiz) {\n        currentInstruction = <InsQuiz goToInstruction={goToInstructionHandler.bind(this, INS_PHASES.overview)} />;\n    }\n\n    return (\n        currentInstruction\n    );\n};\n\nexport default Instructions;","/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Instruction/InsTask.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/GameFrame/GameFrame.js",["269","270","271","272","273"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/store/reducers/conditionData.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/StructureFrame/StructureFrame.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/PlanetFrame/PlanetFrame.js",["274","275","276","277"],"import React, { useState } from 'react';\nimport Button from '../../components/Button/Button';\nimport Agent from '../Agent/Agent';\nimport Action from '../Action/Action';\nimport Scores from '../Scores/Scores';\nimport { useDispatch, useSelector } from 'react-redux';\nimport classes from './PlanetFrame.module.css';\nimport { storeSELECTION } from '../../store/actions/participantData';\nimport blueFishImage from '../../static/images/blue_fish.png';\nimport redFishImage from '../../static/images/red_fish.png';\n\n\n\nconst PlanetFrame = props => {\n    const dispatch = useDispatch();\n    const conditionNumber = useSelector(state => state.conditionData.conditionNumber);\n    const scenario = useSelector(state => state.conditionData.conditionData[state.conditionData.conditionNumber]);\n    const [buttonDisplay, setButtonDisplay] = useState('none');\n    const [confDisplay, setConfDisplay]= useState('none');\n    const fish = scenario.targetBelief;\n    const [selPlanetColor, setSelPlanetColor] = useState('none'); \n\n    const displayFish = {'red': ['', 'none'],\n                         'deepskyblue': ['none', '']};\n\n    const selectPlanetRED = () => {\n        setPlanetSelectRED('1.0');\n        setPlanetSelectBLUE('0.2');\n        setConfDisplay('');\n        setPlanetSelected('red')\n        setConfColor('red');\n        setSelPlanetColor('red');\n    };\n\n    const selectPlanetBLUE = () => {\n        setPlanetSelectBLUE('1.0');\n        setPlanetSelectRED('0.2');\n        setConfDisplay('');\n        setPlanetSelected('blue')\n        setConfColor('deepskyblue');\n        setSelPlanetColor('blue');\n    };\n\n    const selectVeryLowConfidence = () => {\n        setVeryLowConfidence('1.0');\n        setLowConfidence('0.2');\n        setMediumConfidence('0.2');\n        setHighConfidence('0.2');\n        setVeryHighConfidence('0.2');\n        setButtonDisplay('');\n        setConfidence(0);\n    }; \n\n\n    const selectLowConfidence = () => {\n        setVeryLowConfidence('0.2');\n        setLowConfidence('1.0');\n        setMediumConfidence('0.2');\n        setHighConfidence('0.2');\n        setVeryHighConfidence('0.2');\n        setButtonDisplay('');\n        setConfidence(1);\n    }; \n\n    const selectMediumConfidence = () => {\n        setVeryLowConfidence('0.2');\n        setLowConfidence('0.2');\n        setMediumConfidence('1.0');\n        setHighConfidence('0.2');\n        setVeryHighConfidence('0.2');\n        setButtonDisplay('');\n        setConfidence(2);\n    }; \n\n    const selectHighConfidence = () => {\n        setVeryLowConfidence('0.2');\n        setLowConfidence('0.2');\n        setMediumConfidence('0.2');\n        setHighConfidence('1.0');\n        setVeryHighConfidence('0.2');\n        setButtonDisplay('');\n        setConfidence(3);\n    }; \n\n    const selectVeryHighConfidence = () => {\n        setVeryLowConfidence('0.2');\n        setLowConfidence('0.2');\n        setMediumConfidence('0.2');\n        setHighConfidence('0.2');\n        setVeryHighConfidence('1.0');\n        setButtonDisplay('');\n        setConfidence(4);\n    }; \n    \n\n    const [PlanetSelectRED, setPlanetSelectRED] = useState('.2');\n    const [PlanetSelectBLUE, setPlanetSelectBLUE] = useState('.2');\n    const [veryLowConfidence, setVeryLowConfidence] = useState('.2');\n    const [lowConfidence, setLowConfidence] = useState('.2');\n    const [mediumConfidence, setMediumConfidence] = useState('.2');\n    const [highConfidence, setHighConfidence] = useState('.2');\n    const [veryHighConfidence, setVeryHighConfidence] = useState('.2');\n    const [confidence, setConfidence] = useState('0');\n    const [planetSelected, setPlanetSelected] = useState('none');\n    const [confColor, setConfColor] = useState('grey');\n\n    const onNextHandler = () => {\n        dispatch(storeSELECTION({selectedPlanet: planetSelected, confidence: confidence, conditionNumber: conditionNumber}));\n        props.goToGame();\n        setButtonDisplay('none');\n        setPlanetSelectBLUE('0.2');\n        setPlanetSelectRED('0.2');\n        setConfDisplay('none');\n        setVeryLowConfidence('0.2');\n        setLowConfidence('0.2');\n        setMediumConfidence('0.2');\n        setHighConfidence('0.2');\n        setVeryHighConfidence('0.2');\n    };\n  \n   \n    return (\n        <div className={classes.PlanetFrame} style={{display: props.display}}>\n            {/* game interface */}\n            <Agent left={'7%'} width={'35rem'} agent_id=\"instr_frame\" >Which Planet did the fisherman travel?</Agent> \n            \n            {/* Planet Blue */}\n            <Agent onClick={selectPlanetBLUE} top={'8%'} left={scenario.planetPosition[0]} opacity={PlanetSelectBLUE} agent_id=\"BPlanet\">\n                <h3>BLUE</h3>    \n            </Agent> \n            \n\n            {/* Planet Red */}\n            <Agent onClick={selectPlanetRED} top={'8%'} left={scenario.planetPosition[1]} opacity={PlanetSelectRED} agent_id=\"RPlanet\" >\n                <h3>RED</h3> \n            </Agent> \n            \n            <Agent display={confDisplay} left={'6%'} top={'57%'} width={'35rem'} agent_id=\"instr_frame\" >How confident are you?</Agent> \n            \n\n            {/* Confidence */}\n            {/* <Action display={confDisplay}  onClick={selectVeryLowConfidence} opacity={veryLowConfidence} action_id='ConfidenceVeryLow'>Not Confident at all</Action> */}\n            <Action background={confColor} display={confDisplay}  onClick={selectLowConfidence} opacity={lowConfidence} action_id='ConfidenceLow'>1 (very unconfident {selPlanetColor})</Action>\n            <Action background={confColor} display={confDisplay}  onClick={selectMediumConfidence} opacity={mediumConfidence} action_id='ConfidenceMedium'>2</Action>\n            <Action background={confColor} display={confDisplay}  onClick={selectHighConfidence} opacity={highConfidence} action_id='ConfidenceHigh'>3 (very confident {selPlanetColor})</Action>\n            {/* <Action display={confDisplay}  onClick={selectVeryHighConfidence} opacity={veryHighConfidence} action_id='ConfidenceVeryHigh'>Highly Confident</Action> */}\n\n            {/* Scores */}\n            {/* score history */}\n            <Scores score_id=\"instr_frame\" >HISTORY</Scores> \n            <Scores score_id=\"B_name\" >{scenario.neighbour1Name.name}</Scores>\n            <Scores score_id=\"C_name\" >{scenario.neighbour2Name.name}</Scores>\n\n           \n            {/* B Scores */}\n            <Scores background={scenario.neighbourBeliefs.a[0]} opacity={scenario.neighbourBeliefs.ac[0]/3} id=\"B1\" score_id=\"B1\" >{scenario.neighbourBeliefs.ac[0].toString()}</Scores> \n            <Scores background={scenario.neighbourBeliefs.a[1]} opacity={scenario.neighbourBeliefs.ac[1]/3} id=\"B2\" score_id=\"B1\"   top={'17%'} >{scenario.neighbourBeliefs.ac[1].toString()}</Scores> \n            <Scores background={scenario.neighbourBeliefs.a[2]} opacity={scenario.neighbourBeliefs.ac[2]/3} id=\"B3\" score_id=\"B1\"  top={'24%'} >{scenario.neighbourBeliefs.ac[2].toString()}</Scores>  \n            <Scores background={scenario.neighbourBeliefs.a[3]} opacity={scenario.neighbourBeliefs.ac[3]/3} id=\"B4\" score_id=\"B1\"  top={'31%'} >{scenario.neighbourBeliefs.ac[3].toString()}</Scores> \n            <Scores background={scenario.neighbourBeliefs.a[4]} opacity={scenario.neighbourBeliefs.ac[4]/3} id=\"B5\" score_id=\"B1\"  top={'39%'} >{scenario.neighbourBeliefs.ac[4].toString()}</Scores> \n            <Scores background={scenario.neighbourBeliefs.a[5]} opacity={scenario.neighbourBeliefs.ac[5]/3} id=\"B6\" score_id=\"B1\"  top={'46%'} >{scenario.neighbourBeliefs.ac[5].toString()}</Scores> \n            <Scores background={scenario.neighbourBeliefs.a[6]} opacity={scenario.neighbourBeliefs.ac[6]/3} id=\"B7\" score_id=\"B1\"  top={'53%'} >{scenario.neighbourBeliefs.ac[6].toString()}</Scores> \n            <Scores background={scenario.neighbourBeliefs.a[7]} opacity={scenario.neighbourBeliefs.ac[7]/3} id=\"B8\" score_id=\"B1\"  top={'60%'} >{scenario.neighbourBeliefs.ac[7].toString()}</Scores> \n            <Scores background={scenario.neighbourBeliefs.a[8]} opacity={scenario.neighbourBeliefs.ac[8]/3} id=\"B9\" score_id=\"B1\" top={'67%'} >{scenario.neighbourBeliefs.ac[8].toString()}</Scores> \n            <Scores background={scenario.neighbourBeliefs.a[9]} opacity={scenario.neighbourBeliefs.ac[9]/3} id=\"B10\" score_id=\"B1\" top={'74%'} >{scenario.neighbourBeliefs.ac[9].toString()}</Scores> \n\n    \n\n            {/* C scores  */}\n            <Scores background={scenario.neighbourBeliefs.b[0]} opacity={scenario.neighbourBeliefs.bc[0]/3} id=\"C1\" score_id=\"C1\" >{scenario.neighbourBeliefs.bc[0].toString()}</Scores>  \n            <Scores background={scenario.neighbourBeliefs.b[1]} opacity={scenario.neighbourBeliefs.bc[1]/3} id=\"C2\" score_id=\"C1\"  top={'17%'}>{scenario.neighbourBeliefs.bc[1].toString()}</Scores> \n            <Scores background={scenario.neighbourBeliefs.b[2]} opacity={scenario.neighbourBeliefs.bc[2]/3} id=\"C3\" score_id=\"C1\"  top={'24%'} >{scenario.neighbourBeliefs.bc[2].toString()}</Scores> \n            <Scores background={scenario.neighbourBeliefs.b[3]} opacity={scenario.neighbourBeliefs.bc[3]/3} id=\"C4\" score_id=\"C1\"  top={'31%'} >{scenario.neighbourBeliefs.bc[3].toString()}</Scores> \n            <Scores background={scenario.neighbourBeliefs.b[4]} opacity={scenario.neighbourBeliefs.bc[4]/3} id=\"C5\" score_id=\"C1\"  top={'39%'} >{scenario.neighbourBeliefs.bc[4].toString()}</Scores> \n            <Scores background={scenario.neighbourBeliefs.b[5]} opacity={scenario.neighbourBeliefs.bc[5]/3} id=\"C6\" score_id=\"C1\" top={'46%'} >{scenario.neighbourBeliefs.bc[5].toString()}</Scores> \n            <Scores background={scenario.neighbourBeliefs.b[6]} opacity={scenario.neighbourBeliefs.bc[6]/3} id=\"C7\" score_id=\"C1\"  top={'53%'} >{scenario.neighbourBeliefs.bc[6].toString()}</Scores> \n            <Scores background={scenario.neighbourBeliefs.b[7]} opacity={scenario.neighbourBeliefs.bc[7]/3} id=\"C8\" score_id=\"C1\"  top={'60%'} >{scenario.neighbourBeliefs.bc[7].toString()}</Scores> \n            <Scores background={scenario.neighbourBeliefs.b[8]} opacity={scenario.neighbourBeliefs.bc[8]/3} id=\"C9\" score_id=\"C1\"  top={'67%'} >{scenario.neighbourBeliefs.bc[8].toString()}</Scores> \n            <Scores background={scenario.neighbourBeliefs.b[9]} opacity={scenario.neighbourBeliefs.bc[9]/3} id=\"C10\" score_id=\"C1\" top={'74%'} >{scenario.neighbourBeliefs.bc[9].toString()}</Scores>   \n\n            {/* legend */}\n            <Agent width={'200px'} top={'65%'} left={'1%'} agent_id=\"legend\" >YOUR FISH:</Agent> \n            <Agent width={'100px'} top={'72%'} left={'0%'} agent_id=\"Fish\" display={displayFish[fish][0]}>\n            <img position={'absolute'} left={'80%'} top={'50%'} height={'50px'} src={redFishImage} alt=\"fish\"/>\n            </Agent>\n            <Agent width={'100px'} top={'72%'} left={'0%'} agent_id=\"Fish\" display={displayFish[fish][1]}>\n            <img position={'absolute'} left={'80%'} top={'50%'} height={'50px'} src={blueFishImage} alt=\"fish\"/>\n            </Agent>\n\n    \n\n            \n          \n\n            <Action action_id=\"border_frame\"></Action>\n\n            {props.children}\n\n            <Button disabled={buttonDisplay} position={'absolute'} left={'40%'} top={'105%'} clicked={onNextHandler}>Next</Button>\n        </div>\n        \n    );\n};\n\n\nexport default PlanetFrame; \n\n\n","/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/NextPlanet/NextPlanetFrame.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Fish/FishFrame.js",["278","279"],"import React, { useState } from 'react';\nimport { useDispatch, useSelector } from 'react-redux';\nimport Agent from '../Agent/Agent';\nimport blueFishImage from '../../static/images/blue_fish_cooked.png';\nimport redFishImage from '../../static/images/red_fish_cooked.png';\nimport Button from '../../components/Button/Button';\nimport Classes from './FishFrame.module.css';\n\n\n\nconst FishFrame = props => {\n   \n    const scenario = useSelector(state => state.conditionData.conditionData[state.conditionData.conditionNumber]);\n    const fish = scenario.targetBelief;\n\n    const displayFish = {'red': ['', 'none'],\n                         'deepskyblue': ['none', '']};\n    \n\n\n    return (\n\n        <div className={Classes.FishFrame}  style={{display: props.display}}>\n             {props.children}\n            <Agent width={'400px'} agent_id=\"Fish\" display={displayFish[fish][0]}>\n            <p>In this village, cooking revealed that the fish is <b>RED</b>!</p>\n            <img position={'absolute'} left={'80%'} top={'30%'} height={'300px'} src={redFishImage} alt=\"fish\"/>\n            </Agent><br></br><br></br>\n            <Agent width={'400px'} agent_id=\"Fish\" display={displayFish[fish][1]}>\n            <p>In this village, cooking revealed that the fish is <b>BLUE</b>!</p>\n            <img position={'absolute'} left={'80%'} top={'30%'} height={'300px'} src={blueFishImage} alt=\"fish\"/>\n        </Agent>\n        \n        <Button position={'absolute'} left={'40%'} top={'105%'} clicked={props.goToGame}>Next</Button>\n   </div>        \n    );\n};\n\nexport default FishFrame; \n\n\n","/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Instruction/InsTask2.js",["280","281"],"import React, { useState, useEffect } from 'react';\nimport Button from '../../components/Button/Button';\nimport relationshipImage from '../../static/images/select_relationship.png';\nimport planetImage from '../../static/images/select_planet.png';\nimport fishImage from '../../static/images/fish_instruct.png';\nimport observeImage from '../../static/images/observe_beliefs.png';\nimport confImage from '../../static/images/confidence_meaning.png';\nimport Classes from '../../SASS/containers/Instruction/InsTask2.module.scss';\nimport ScrollDivision from '../../components/ScrollDivision/ScrollDivision';\n\nconst InsTask= props => {\n    const [btnDisplay, setBtnDisplay] = useState(false)\n\n    const showBtn = (e) => {\n        debugger;\n        console.log(e.target.scrollHeight);\n        console.log(e.target.scrollTop);\n        if (e.target.scrollTop + e.target.offsetHeight >= e.target.scrollHeight) {\n            setBtnDisplay(true);\n        }\n    };\n\n    return (\n        <div className={Classes.InsTask}>\n            \n            <div className={Classes.InnerContainer}>\n                <h1>Instructions: Procedure</h1>\n                <hr />           \n                <div className={Classes.InsReminder}>\n                    <p><i>*** Scroll through the division below to see details. ***</i></p>\n                   \n                </div> \n                <ScrollDivision scroll={showBtn}>\n                <p>In each village, you first cook your fish and observe the color:</p><br></br>\n                <img src={fishImage} alt=\"planets\"/><br></br><br></br>\n                <p>You then observe the beliefs of villagers by clicking the ``<b>Observe Beliefs</b>'' button:</p><br></br>\n                <img src={observeImage} alt=\"planets\"/><br></br><br></br>\n                <p>Beliefs of villagers can either be blue or red. In addition to their beliefs, villagers also tell you how confident they are in their beliefs on a <b>scale from 1 (very unconfident) - 3 (very confident)</b>. The <b>more confident</b> they are, the more likely they think the space fisherman travelled the selected planet. The confidence is displayed together with their beliefs:</p><br></br>\n                <img src={confImage} alt=\"planets\"/><br></br><br></br>\n                <p>After observing the beliefs of villagers, you will provide a <b>guess about their relationship</b> and receive a bonus of £0.25 for each correct selection:</p><br></br>\n                <img src={relationshipImage} alt=\"planets\"/><br></br><br></br>\n                <p>Finally, you will be asked to select one of the two planets and rate <b>how confident</b> you are in your decision (again, receiving a bonus of £0.25 for each correct selection):</p>\n                <img src={planetImage} alt=\"planets\"/>\n                <hr />\n                <Button clicked={props.goToInstruction}>Next</Button>\n                {/* {btnDisplay && <Button clicked={props.goToInstruction}>Next</Button>} */}\n                </ScrollDivision >\n              \n                {/* {btnDisplay ? <Button clicked={props.goToInstruction}>Next</Button>: <Button >Please scroll down</Button>} */}\n            </div>\n        </div>\n    );\n};\n\nexport default InsTask;","/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/ScrollDivision/ScrollDivision.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/store/actions/participantID.js",["282"],"export const STORE_PID = 'STORE_PID';\n\nconst w = window;\n\nexport const storePID = pidData => {\n    const pid = pidData.PID;\n    console.log(pid);\n    return { type: STORE_PID, pidData: {pid: pid}};\n};\n\n","/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/store/reducers/participantID.js",[],{"ruleId":"283","replacedBy":"284"},{"ruleId":"285","replacedBy":"286"},{"ruleId":"283","replacedBy":"287"},{"ruleId":"285","replacedBy":"288"},{"ruleId":"283","replacedBy":"289"},{"ruleId":"285","replacedBy":"290"},{"ruleId":"283","replacedBy":"291"},{"ruleId":"285","replacedBy":"292"},{"ruleId":"283","replacedBy":"293"},{"ruleId":"285","replacedBy":"294"},{"ruleId":"295","severity":1,"message":"296","line":6,"column":1,"nodeType":"297","endLine":31,"endColumn":2},{"ruleId":"298","severity":1,"message":"299","line":7,"column":11,"nodeType":"300","messageId":"301","endLine":7,"endColumn":27},{"ruleId":"283","replacedBy":"302"},{"ruleId":"285","replacedBy":"303"},{"ruleId":"295","severity":1,"message":"304","line":1,"column":1,"nodeType":"297","endLine":9,"endColumn":3},{"ruleId":"283","replacedBy":"305"},{"ruleId":"285","replacedBy":"306"},{"ruleId":"283","replacedBy":"307"},{"ruleId":"285","replacedBy":"308"},{"ruleId":"298","severity":1,"message":"309","line":5,"column":7,"nodeType":"300","messageId":"301","endLine":5,"endColumn":8},{"ruleId":"283","replacedBy":"310"},{"ruleId":"285","replacedBy":"311"},{"ruleId":"283","replacedBy":"312"},{"ruleId":"285","replacedBy":"313"},{"ruleId":"283","replacedBy":"314"},{"ruleId":"285","replacedBy":"315"},{"ruleId":"283","replacedBy":"316"},{"ruleId":"285","replacedBy":"317"},{"ruleId":"295","severity":1,"message":"318","line":1,"column":1,"nodeType":"297","endLine":8,"endColumn":2},{"ruleId":"283","replacedBy":"319"},{"ruleId":"285","replacedBy":"320"},{"ruleId":"295","severity":1,"message":"296","line":1,"column":1,"nodeType":"297","