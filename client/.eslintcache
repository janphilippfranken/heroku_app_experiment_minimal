ar,\n                    a: action.posteriorData.a,\n                    b: action.posteriorData.b\n                };\n                const oldStatePosterior = [...state];\n                oldStatePosterior[action.conditionNumber].posterior = posterior;\n                return oldStatePosterior;\n\n        default:\n            return state;\n    }\n}",["194","195"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/End.js",[],["196","197"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/store/actions/timer.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/uoeSignature/uoeSignature.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/TryAgainModal.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/constants/draw-network/network_variables.js",["198"],"export default {\n    nodes: ['node1', 'node2'],\n    lines: ['line1', 'line2'],\n    legs: ['legl1', 'legr1', 'legl2', 'legr2'],\n    arms: ['arml1', 'armr1', 'arml2', 'armr2'],\n    bodies: ['body1', 'body2'],\n    arrows: ['arrow1', 'arrow2'],\n    vs: ['vs']\n};\n",["199","200"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Backdrop/Backdrop.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/store/reducers/timer.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/store/actions/conditionData.js",[],["201","202"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/store/actions/participantData.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/timer/Timer.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/