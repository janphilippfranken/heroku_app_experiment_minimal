s.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Ethics.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Experiment/Scenario.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/utils/generate-token.js",["192"],"export default function(length) {\n    let tokens = '';\n    let chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';\n    for (let i = 0; i < length; i ++) {\n        tokens += chars.charAt(Math.floor(Math.random() * chars.length))\n    }\n    return tokens;\n};","/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/utils/shuffleArray.js",["193"],"export default (array) => {\n    for (var i = array.length - 1; i > 0; i--) {\n        var j = Math.floor(Math.random() * (i + 1));\n        var temp = array[i];\n        array[i] = array[j];\n        array[j] = temp;\n    }\n    return array;\n}","/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/constants/Data/SCENARIOS.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/utils/AlphaBetaToArrayData.js",["194"],"export default (alpha, beta) => {\n\n    const w = window;\n    var mean = w.jStat.beta.mean(alpha, beta);\n    var variance = w.jStat.beta.variance(alpha, beta);\n\n    var con_slid_val = w.inverse_log_slider(variance);\n    var con_slid_pos = w.transform_con_slider_val(con_slid_val);\n\n    var x = w.create_arrays(0.01, .99, 1000, alpha, beta)[0];\n    var y = w.create_arrays(0.01, .99, 1000, alpha, beta)[1];\n    return { mean: mean, var: con_slid_pos, x: x, y: y };\n};",["195","196"],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/containers/Debrief.js",[],"/Users/jan-philippfranken/Documents/GitHub/experiment_node_js_simon_jp/server/client/src/components/Experiment/Condition.js",[],"/Us